# Finais de linha: LF no repositório e na pasta de trabalho, em qualquer sistema.
* text=auto eol=lf

# Scripts e hooks precisam de LF para rodar no Git Bash, no Mac e no Linux
*.sh text eol=lf
.githooks/* text eol=lf

# Arquivos que só rodam no Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
